# Copy this file to `.env` and replace the placeholder with your real connection string.
# Requires PostgreSQL >= 15.
# Local defaults match docker-compose.yml (pto/pto @ ai_pto on host port 5433).
# Port 5433 avoids conflict with a host Postgres already bound to 5432.

DATABASE_URL="postgresql://pto:pto@localhost:5433/ai_pto"
