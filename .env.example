# Copy to `.env` for local (host) tools: yarn start:dev, prisma CLI from the host.
# Docker Compose injects its own DATABASE_URL / REDIS_URL for the `api` service.

# Host → Docker Postgres published on 5433 (container listens on 5432).
DATABASE_URL="postgresql://pto:pto@localhost:5433/ai_pto"

# Nest HTTP port (compose maps host PORT → container 3000).
PORT=3000

# Host → Docker Redis published on 6379.
REDIS_URL=redis://localhost:6379

# Способ входа: `zitadel` (OIDC, по умолчанию) или `local` (email/пароль из БД, ZITADEL не нужен).
# При `local` переменные ZITADEL_* ниже не используются. Пользователь: `yarn user:create` (см. README).
AUTH_PROVIDER=zitadel

# ZITADEL OIDC (только AUTH_PROVIDER=zitadel; Authorization Code + PKCE + Private Key JWT)
# Issuer = External Domain of the local ZITADEL stack (see zitadel/.env).
ZITADEL_ISSUER=http://localhost:8080
# Application → Client ID from ZITADEL Console.
ZITADEL_CLIENT_ID=392912908855607299
# Path to JSON key downloaded from Console (Application → Keys → New).
# Do not commit this file. Example: ./secrets/zitadel-app-key.json
ZITADEL_KEY_PATH=./secrets/zitadel-app-key.json
# Must match Redirect URI registered in the ZITADEL application.
ZITADEL_REDIRECT_URI=http://localhost:3000/api/auth/callback
ZITADEL_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/api/auth/me

# Session cookie
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
